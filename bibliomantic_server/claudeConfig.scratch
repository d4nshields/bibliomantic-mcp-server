github:

    "bibliomantic": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/d4nshields/bibliomantic-mcp-server",
        "bibliomantic-mcp-server"
      ]
    }

github, always fetch latest main (test platforms; needs network at every start):

    "bibliomantic": {
      "command": "uvx",
      "args": [
        "--refresh-package",
        "bibliomantic-mcp-server",
        "--from",
        "git+https://github.com/d4nshields/bibliomantic-mcp-server",
        "bibliomantic-mcp-server"
      ]
    }

local filesystem (windows):

    "bibliomantic": {
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--directory",
        "C:\\Users\\d4nsh\\werk\\bibliomantic-mcp-server",
        "bibliomantic-mcp-server"
      ]
    }

local filesystem (linux):

    "bibliomantic": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/home/daniel/work/bibliomantic-mcp-server",
        "bibliomantic-mcp-server"
      ]
    }
